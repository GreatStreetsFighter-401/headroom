# Example environment file — safe to commit.
#
# Copy to `.env` (git-ignored) and fill in real values locally, or export the
# variables in your shell. NEVER commit a populated `.env`. Nothing here is
# required: the tool runs with no environment variables at all.

# Optional. A free Census API key (https://api.census.gov/data/key_signup.html)
# lets `headroom acquire` read ACS tables from the Census API. Without it the
# same tables are streamed from the Census summary files, which need no key.
CENSUS_API_KEY=

# Optional. Path to a locally saved copy of Rhode Island's 2025 Integrated
# Housing Report, for hosts whose network the State's site refuses (HTTP 403).
# The report is otherwise downloaded from housing.ri.gov.
HEADROOM_EOH_PDF=

# Optional. Port for the page served by scripts/run.sh (default 8765).
PORT=8765
